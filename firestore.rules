rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /users/{userId}/brandKits/{kitId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(kitId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && isValidId(kitId) && request.resource.data.userId == userId;
      allow delete: if isOwner(userId) && isValidId(kitId);
    }

    match /publicBrandKits/{shareId} {
      // Public read-only access for anyone with the unique link
      allow read: if true;
      // Allow creation of public share link
      allow create: if isValidId(shareId)
        && request.resource.data.shareId == shareId
        && request.resource.data.isPublic == true;
      // Allow creator to update, or allow viewsCount increment
      allow update: if isValidId(shareId) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid)
      );
      // Only the creator can delete
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }
  }
}
